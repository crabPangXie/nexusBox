<stack class="container" style="background-color: #050505;">
    <list class="container" style="flex-direction: row;" on:touchstart="hideKbd" on:click="switchKbd" on:touchend="appearKbd" on:scrolltop="scrollStart" grab:longpress="pressText">
        <list-item style="width: 95px;background-color: #151515;"></list-item>
        <list-item style="height: 100%;width: 2px;background-color: #333333;"></list-item>
        <list-item class="code_container_column" style="margin-left:-95px;">
            <list class="container" style="flex-direction: column;" ref="list">
                <list-item style="height: 38px;"></list-item><list-item style="height: 38px;"></list-item>
                <list-item class="code_container_row" for="{{prevLines}}">
                    <text class="code_num" style="font-family: {{numFont}};" grab:click="jumpToLine($idx)">{{$idx+1}}</text>
                    <text style="line-height:38px;color: {{fontColor}};">{{$item}}</text>
                </list-item>
                <list-item class="code_container_row">
                    <text class="code_num" style="color: #B3B7B9;font-family: {{numFont}};" grab:click="jumpToLine(prevLines.length)">{{prevLines.length+1}}</text>
                    <text style="line-height:38px;color: {{fontColor}};">{{text}}</text>
                    <div class="text_cursor" style="opacity: {{showCursor||cursorSteady?1:0}};margin-left: {{text.length==0?0:-2}};margin-right: {{text.length==0?-3:-1}}"></div>
                    <text style="line-height:38px;color: {{fontColor}};">{{nextText}}</text>
                </list-item>
                <list-item class="code_container_row" for="{{nextLines}}">
                    <text class="code_num" style="font-family: {{numFont}};" grab:click="jumpToLine(prevLines.length+1+$idx)">{{prevLines.length+2+$idx}}</text>
                    <text style="line-height:38px;color: {{fontColor}};">{{$item}}</text>
                </list-item>
                <list-item style="height: 360px;"></list-item>
            </list>
        </list-item>
    </list>

    <image style="width: 466px;height: 50px;top: 416px;object-fit:fill"  src="/common/keyboard/pyShadow.png" grab:click="code"></image>
    <div class="tool_div">
        <input grab:click="run" class="btn_mini" style="margin-top: -20px;background-image:url('/common/script/run.png');"></input>
        <input grab:click="code" class="btn_mini" style="background-image:url('/common/script/code.png');"></input>
        <input grab:click="showExitConfirm" class="btn_mini" style="margin-top: -20px;background-image:url('/common/script/save.png');"></input>
    </div>

    <stack class="container keyAni" style="top: {{showKbd&&displayKbd?0:365}};animation-name: {{showKbd&&displayKbd?'appear':'hide'}};">
    <!--        拼音栏-->
        <image if="{{!!pinyin}}" style="width: 466px;height: 35px;top: 99px;" src="/common/keyboard/pyShadow.png"></image>
        <text if="{{!!pinyin}}" style="left: 50px;top:96px;height: 38px;color:#3895FF;">{{pinyin}}</text>
    <!--键盘背景-->
        <stack class="keyContainer" grab:swipe="grabTouch">
        <!--        工具栏-->
            <image class="bar" grab:click="clickFn" grab:longpress="pressFn" grab:touchend="stopOperate" src="/common/keyboard/toolBar.png"></image>
            <image style="width: 31px;height: 31px;left: 128px;top: 21px;" src="/common/keyboard/key{{keyType}}.png"></image>
        <!--        中文候选栏-->
            <stack show="{{!!pinyin}}" class="bar" grab:click="expandPy">
                <image class="container" src="/common/keyboard/selectBar.png"></image>
                <list class="bar_pyList">
                    <list-item style="width: 5px;"></list-item>
                    <list-item grab:click="clickCn($idx)" class="bar_pyItem" style="width: {{$item.word.length*30+10}};" for="{{pyList}}">
                        <text>{{$item.word}}</text>
                    </list-item>
                    <list-item style="width: 40px;">
                    </list-item>
                </list>
                <image class="bar_shadow" src="/common/keyboard/shadow.png"></image>
                <image class="bar_cover" src="/common/keyboard/toolCover.png"></image>
            </stack>
        <!--        删除键-->
            <input class="delete" grab:click="delete" grab:longpress="pressDelete" grab:touchend="stopOperate"></input>
        <!--        键盘本体-->
            <image grab:click="click" grab:longpress="press"  grab:touchstart="touchStart" grab:touchmove="touchMove" grab:touchend="touchEnd" class="keyboard" style="width: {{keyType==3?741:570}};left: {{keyPos}};opacity: {{1-aniOpacity}};" src="/common/keyboard/{{keyType}}.png"></image>
        <!--        用于切换键盘时播放动画的图片-->
            <image class="keyboard" if="{{!!aniPos}}" style="width: {{aniType==3?741:570}};left: {{aniPos+keyPos}};opacity: {{aniOpacity}};" src="/common/keyboard/{{aniType}}.png"></image>
        <!--        切换提示-->
            <image class="tip" show="{{!aniPos}}" style="left: {{keyPos-68}};opacity: {{(keyPos-40)/30}};" if="true" src="/common/keyboard/switchL.png"></image>
            <image class="tip" show="{{!aniPos}}" style="left: {{keyPos+(keyType==3?741:570)+30}};opacity: {{-(keyPos+(keyType==3?275:104)+40)/30}};" src="/common/keyboard/switchR.png"></image>
        <!--        底部滑动进度条-->
            <stack class="progress"></stack>
            <image src="/common/keyboard/dot.png" class="progress_dot" style="left: {{165+(aniPos?aniDotPos:100*keyPos/(keyType==3?-275:-104))}};"></image>
        <!--        space,enter键-->
            <input class="btn" grab:click="clickSpace" style="left: 131px;background-image:url('/common/keyboard/space.png');"></input>
            <input class="btn" grab:click="enter" style="left: 265px;background-image:url('/common/keyboard/enter.png');"></input>
        </stack>
        <text class="popup" show="{{!!popup.text}}" style="opacity: {{popup.lowerLimit>0?(popup.lowerLimit-popup.top)/20:1}};animation-name: {{!popup.lowerLimit&&popup.text?'pop':''}};left: {{popup.left}};top: {{popup.lowerLimit>0?Math.min(popup.lowerLimit,popup.top):popup.top}};">{{popup.text}}</text>
    </stack>

<!--    弹窗-->
    <stack class="container" if="{{alertShow||confirmShow}}" on:click="close" style="background-color: #26000000;" grab:swipe="close"></stack>
    <div class="alert" show="{{alertIf}}" style="top: {{100+(alertShow?0:380)}};animation-name: {{alertShow?'up':'down'}};" on:swipe="close">
        <stack class="alert_bar">
            <list class="alert_title" show="{{showCode}}" grab:swipe="grabTouch">
                <list-item style="width: 10px;"></list-item>
                <list-item class="alert_option" style="background-color: {{codeIdx==$idx?'#1458DF':'#323232'}};" for="{{codeTitle}}" on:click="changeCode($idx)">
                    <text class="container" style="height: 30px;">{{$item}}</text></list-item>
            </list>
            <image style="width: 40px;height: 60px;left: 10px;" src="/common/script/shadowL.png"></image>
            <image style="width: 40px;height: 60px;left: 280px" src="/common/script/shadowR.png"></image>
            <text if="{{!showCode}}" style="height: 100%;font-size: 38px;left: 20px;font-family: {{font}};">{{showPy?'更多选项':'剪切板('+shearList.length+'/15)'}}</text>
            <input class="alert_close" on:click="closeAlert"></input>
        </stack>
        <list class="alert_list" style="width: 360px;" show="{{showCode}}" ref="code">
            <list-item class="alert_item" for="{{codeList[codeIdx]}}">
                <text class="alert_shear" on:click="input($item.code)">{{$item.name}}</text>
            </list-item>
            <list-item style="height: 110px;"></list-item>
        </list>
        <list class="alert_list" show="{{!showCode&&showPy}}" ref="py">
            <list-item class="alert_smallItem" for="{{pyFullList}}">
                <text class="alert_py" on:click="clickCn($idx*4)">{{$item[0].word}}</text>
                <text class="alert_py" on:click="clickCn($idx*4+1)" style="opacity: {{1-!$item[1]}};">{{$item[1].word}}</text>
                <text class="alert_py" on:click="clickCn($idx*4+2)" style="opacity: {{1-!$item[2]}};">{{$item[2].word}}</text>
                <text class="alert_py" on:click="clickCn($idx*4+3)" style="opacity: {{1-!$item[3]}};">{{$item[3].word}}</text>
            </list-item>
            <list-item class="alert_smallItem">
                <text style="font-size: 24px;color: grey;">{{pyFullList.length>0?'':'加载中,请稍后'}}</text>
            </list-item>
        </list>
        <list class="alert_list" style="width: 360px;" show="{{!showCode&&!showPy}}" ref="shear">
            <list-item class="alert_item" for="{{shearList}}">
                <text class="alert_shear" on:click="input($item)">{{$item}}</text>
            </list-item>
            <list-item class="alert_smallItem">
                <text style="font-size: 24px;color: grey;">长按文字区域可复制当前行</text>
            </list-item>
            <list-item style="height: 80px;"></list-item>
        </list>
    </div>
<!--    退出确认弹窗-->
    <div class="confirm" show="{{confirmIf}}" style="top: {{150+(confirmShow?0:330)}};animation-name: {{confirmShow?'confirmUp':'confirmDown'}};" grab:click="grabTouch">
        <text class="confirm_title" style="font-family: {{font}};">是否保存?</text>
        <div class="confirm_row">
            <input class="confirm_btn" value="放弃" grab:click="discardAndExit"></input>
            <div style="width: 1px;height: 30px;background-color: #505050;"></div>
            <input class="confirm_btn" style="color: #3895FF;" value="保存并退出" grab:click="saveAndExit"></input>
        </div>
    </div>

    <text class="msg" if="{{!!msg.content}}" on:click="closeMsg">{{ msg.content }}</text>
</stack>
