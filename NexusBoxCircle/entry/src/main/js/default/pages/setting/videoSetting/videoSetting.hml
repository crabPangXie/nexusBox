<stack class="container" on:swipe="close">
    <image style="width: 466px;height: 480px;" src="/common/device/bgd.png"></image>
    <list class="list" ref="list">
        <list-item class="item_title">
            <text style="font-size: 38px;font-family: {{font}};">视频播放</text>
        </list-item>
        <list-item class="item_card">
            <text class="item_name">循环播放</text>
            <switch class="item_switch" checked="{{videoAuto}}" on:change="onVideoAuto"></switch>
        </list-item>
        <list-item style="width:100%;height: 140px;justify-content: flex-start;align-items: flex-start;">
            <text style="width:100%;padding: 0px 20px;color: #b3ffffff;font-size: 24px;">视频将自动循环播放。受性能限制，播放中屏幕触控无效，请等待暂停后再操作。如需中途退出，点击手表上键即可。</text>
        </list-item>
        <list-item class="item_card">
            <text class="item_name">播控中心常驻</text>
            <switch class="item_switch" checked="{{videoControl}}" on:change="onVideoControl"></switch>
        </list-item>
        <list-item style="width:100%;height: 200px;justify-content: flex-start;align-items: flex-start;">
            <text style="width:100%;padding: 0px 20px;color: #b3ffffff;font-size: 24px;">开启后，视频播放信息将在系统播控中心展示。</text>
        </list-item>
    </list>
</stack>
