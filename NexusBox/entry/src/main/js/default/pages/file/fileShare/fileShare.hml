<stack class="container" style="background-color: #EDEDED;" on:swipe="close">
    <list class="container" ref="list">
        <list-item class="bar_item">
            <div class="bar_title">
                <text class="bar_text" style="font-family: {{font}};">文本分享</text>
                <marquee style="width:100%;height: 28px;color: #383838;font-size: 24px;margin-top: 5px;text-align: center;">{{title}}</marquee>
            </div>
            <image on:click="changeAuto" class="auto" src="/common/share/{{auto?'auto':'unAuto'}}.png"></image>
        </list-item>
        <list-item if="{{!!text}}" class="list-item" style="height: 260px;">
            <qrcode style="width: 260px;height: 260px;background-color: #EDEDED;" value="{{text}}"></qrcode>
        </list-item>
        <list-item else class="list-item" style="height: 260px;flex-direction: column;">
            <image src="/common/empty.png" style="width: 100px;height: 100px;margin-top: -20px;"></image>
            <text style="color: #303030">未读取到内容</text>
        </list-item>
        <list-item class="list-item" style="height: 80px;">
            <input class="btn" on:click="less" style="background-image: url('/common/share/left.png');"></input>
            <text class="btn_text" style="width: 120px;">{{progress}}%</text>
            <input class="btn" on:click="more" style="background-image: url('/common/share/right.png');"></input>
        </list-item>
        <list-item class="list-item" style="height: 20px;align-items: flex-start;">
            <div class="bar"></div>
        </list-item>
        <list-item class="bar_item" style="height: 70px;">
            <text class="bar_text">读取长度</text>
        </list-item>
        <list-item class="list-item" style="height: 75px;">
            <div class="btn_container">
                <input class="btn" on:click="changeLength('reduce')" on:longpress="pressLength('reduce')" on:touchend="operateRelease" style="background-image: url('/common/share/left.png');"></input>
                <text class="btn_text">{{length}}</text>
                <input class="btn" on:click="changeLength('add')" on:longpress="pressLength('add')" on:touchend="operateRelease" style="background-image: url('/common/share/right.png');"></input>
            </div>
        </list-item>
        <list-item class="bar_item" style="height: 70px;">
            <text class="bar_text">读取位置</text>
        </list-item>
        <list-item class="list-item" style="height: 75px;">
            <div class="btn_container">
                <input class="btn" on:click="changeStart('reduce')" on:longpress="pressStart('reduce')"  on:touchend="operateRelease" style="background-image: url('/common/share/left.png');"></input>
                <text class="btn_text">{{start}}</text>
                <input class="btn" on:click="changeStart('add')" on:longpress="pressStart('add')" on:touchend="operateRelease" style="background-image: url('/common/share/right.png');"></input>
            </div>
        </list-item>
        <list-item class="bar_item" style="height: 70px;" if="{{!!text}}">
            <text class="bar_text">文本预览</text>
        </list-item>
        <list-item class="list-item" style="height:{{height}};" if="{{!!text}}">
            <text class="text" style="height: {{height}};">{{text}}</text>
        </list-item>
        <list-item style="height: {{Math.max(120-height,60)}};"></list-item>
    </list>
    <input class="bar_back" grab:click="close"></input>
    <text class="msg" if="{{!!msg.content}}" grab:click="closeMsg">{{ msg.content }}</text>
</stack>
